# ─── Required to run at all ──────────────────────────────────────────────────

# Service role key bypasses RLS — never expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.saasna.me

# Leave blank in dev/preview.
NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ─── Required for the product to do anything ────────────────────────────────

# Clustering + summarization. Without it the Discover feed stays empty.
OPENAI_API_KEY=

# Naming module. Absent: /api/generate returns 503.
DEEPSEEK_API_KEY=

# Web search presence probe. Absent: that check reports "unknown".
FIRECRAWL_API_KEY=


# ─── Payments ───────────────────────────────────────────────────────────────

# "production" switches off sandbox. Anything else, including unset, is sandbox.
NEXT_PUBLIC_PADDLE_ENV=sandbox

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Unset price IDs hide the plan rather than render a broken checkout button.
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ID_CREDITS_25=
NEXT_PUBLIC_PADDLE_PRICE_ID_CREDITS_100=


# ─── Email ──────────────────────────────────────────────────────────────────

RESEND_API_KEY=
# Must be on a Resend-verified domain.
RESEND_FROM_EMAIL=SaaSNa.me <noreply@saasna.me>


# ─── Internal infrastructure ────────────────────────────────────────────────

# Bearer token Vercel Cron sends to internal ingest/pipeline routes.
CRON_SECRET=


# ─── Trend connectors (optional) ────────────────────────────────────────────

# The other seven connectors need no credentials.

# Raises GitHub search rate limit 10 → 30 req/min.
GITHUB_TOKEN=

# Search-demand signals. Unset returns no signals rather than erroring.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=


# ─── Trend tuning ───────────────────────────────────────────────────────────

# Kill switch per connector: INGEST_<ID>_ENABLED=false. IDs are HACKER_NEWS,
# GITHUB, NPM, PYPI, RSS, ARXIV, HUGGING_FACE, STACK_EXCHANGE, DATAFORSEO.
# INGEST_DATAFORSEO_ENABLED=false

# Bars a topic must clear to publish. On a fresh database most topics have one
# source, so set MIN_SOURCES=1 to bootstrap, then raise it.
TRENDS_PUBLISH_CONFIDENCE_THRESHOLD=40
TRENDS_PUBLISH_MIN_SOURCES=2

# Cosine similarity to merge a signal into an existing topic. Higher = more,
# smaller topics; too high and nothing merges at all.
TRENDS_MERGE_THRESHOLD=0.72

# Signals embedded / topics summarized per run. Raise for a one-off backlog pass.
TRENDS_CLUSTER_BATCH_SIZE=200
TRENDS_SUMMARY_BATCH_SIZE=50

# Chat model for topic summaries.
TRENDS_SUMMARY_MODEL=gpt-4.1-mini


# ─── Optional ───────────────────────────────────────────────────────────────

# Salt for demo rate-limit hashing. Unset falls back to a weaker constant.
DEMO_IP_SALT=

# Dev only. Treats every signed-in user as paid. Inert when NODE_ENV=production.
DEV_UNLOCK_PAYMENTS=false


# ─── Not read by the application ────────────────────────────────────────────
#
# Google sign-in is configured in the Supabase dashboard, not here.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are unused.
# NEXTAUTH_URL / NEXTAUTH_SECRET are boilerplate leftovers.
