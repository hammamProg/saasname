# ─── Required to run at all ──────────────────────────────────────────────────

# Supabase project URL and keys. Anon key is public by design; the service role
# key bypasses row-level security and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The canonical origin, no trailing slash. Used for canonical URLs, the
# sitemap, OAuth redirects and Paddle success URLs, so it must match the
# domain the app is actually served from.
NEXT_PUBLIC_SITE_URL=https://saasna.me


# ─── Required for the product to do anything ────────────────────────────────

# Writes candidate names and the one-line summary on each report.
# Absent: /api/generate returns 503 and the demo still runs.
DEEPSEEK_API_KEY=

# Web search presence probe. Absent: that one check reports "unknown",
# which never reads as available.
FIRECRAWL_API_KEY=


# ─── Payments ───────────────────────────────────────────────────────────────

# "production" switches both the client and the server SDK off sandbox.
# Anything else, including unset, means sandbox.
NEXT_PUBLIC_PADDLE_ENV=sandbox

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Price IDs for the credit packs. A pack with no price ID is hidden rather
# than rendered as a checkout button that cannot work. Sandbox and production
# have different IDs.
NEXT_PUBLIC_PADDLE_PRICE_ID_CREDITS_25=
NEXT_PUBLIC_PADDLE_PRICE_ID_CREDITS_100=


# ─── Email ──────────────────────────────────────────────────────────────────

# Magic-link sign-in and transactional mail.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or delivery fails in production.
RESEND_FROM_EMAIL=SaaSNa.me <noreply@saasna.me>


# ─── Optional ───────────────────────────────────────────────────────────────

# Salt for the landing demo's rate-limit hashing. Any long random string.
# Unset falls back to a constant, which still works but is weaker.
DEMO_IP_SALT=

# Development only. Treats every signed-in user as paid so gated surfaces can
# be exercised without a real checkout. Ignored outright when NODE_ENV is
# production, so shipping it set is inert rather than a billing hole.
DEV_UNLOCK_PAYMENTS=false


# ─── Not read by the application ────────────────────────────────────────────
#
# Google sign-in is configured in the Supabase dashboard (Authentication →
# Providers → Google), not here. GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in
# a local .env file are unused by this codebase.
#
# NEXTAUTH_URL and NEXTAUTH_SECRET are leftovers from the boilerplate. This app
# authenticates through Supabase; neither is read.
